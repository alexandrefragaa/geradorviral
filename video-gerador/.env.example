# Copie este arquivo pra ".env" e preencha com suas chaves reais

# Fish Audio (voz do personagem — Peter Griffin, Stewie, Bob Esponja, Rick Sanchez,
# Gumball, Darwin, Pernalonga, Gaguinho etc.)
FISH_AUDIO_API_KEY=

# OpenAI (Whisper - transcrição p/ legenda sincronizada)
OPENAI_API_KEY=

# YouTube Data API v3 (aba de Trends - vídeos em alta com personagens)
# Gere em: console.cloud.google.com > APIs & Services > Credentials
YOUTUBE_API_KEY=

# --- Geração de imagem do personagem (fal.ai / Seedream) ---
# Gere em: fal.ai > Dashboard > Keys
FAL_API_KEY=

# --- Publicação automática ---
# URL pública onde este servidor está rodando (necessário pro TikTok e Instagram
# puxarem o vídeo — não funciona com localhost). Ex: https://seu-app.onrender.com
PUBLIC_BASE_URL=

# YouTube (upload) — OAuth2, criado em console.cloud.google.com (tipo "Desktop app"),
# com o refresh token gerado uma vez via fluxo OAuth (escopo youtube.upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok — developers.tiktok.com, produto "Content Posting API", exige revisão
# manual do app (2-4 semanas) pra postar público direto
TIKTOK_ACCESS_TOKEN=

# Instagram — developers.facebook.com, conta profissional (Business/Creator)
# vinculada a uma Página do Facebook
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Porta do servidor
PORT=3000
